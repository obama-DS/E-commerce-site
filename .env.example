# Obama Store — AI assistant configuration
# Copy this file to .env and fill in your values, then restart the server.

# OpenAI-compatible API key (works with OpenAI, Groq, OpenRouter, local proxies).
# Leave empty to run the chatbot in offline rule-based mode.
OPENAI_API_KEY=

# OpenAI-compatible base URL (chat completions endpoint prefix).
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Local proxy: e.g. http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name. Examples: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile (Groq),
# openrouter/auto, gemini-flash-latest, gemini-3-flash-preview.
OPENAI_MODEL=gpt-4o-mini

# Extra models (comma separated) tried automatically on 429 quota / 404.
# Gemini free keys are limited per model (20 req/day each), so fallbacks
# multiply the daily budget.
OPENAI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite

# Request timeout in seconds for LLM calls.
LLM_TIMEOUT=30

# Maximum wall-clock seconds for one assistant turn (includes tool rounds).
LLM_MAX_SECONDS=60

# 'llm' (default, AI assistant when a key is set) or 'rules' (force offline).
CHAT_BACKEND=llm
